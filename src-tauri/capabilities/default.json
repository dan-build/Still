{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the vault commands, listen for events (auto-lock), and be dragged and zoomed by its title strip (the overlay title bar), and nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-touch",
    "allow-lens-new-key",
    "allow-item-encrypt",
    "allow-item-decrypt",
    "allow-item-copy",
    "allow-storage-load",
    "allow-storage-write",
    "allow-storage-import-legacy",
    "allow-vault-state",
    "allow-vault-set-aside",
    "allow-lens-create",
    "allow-lens-rename",
    "allow-lens-forget",
    "allow-lens-restore",
    "allow-lens-delete",
    "allow-item-add",
    "allow-item-update",
    "allow-item-delete",
    "allow-item-reveal",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
