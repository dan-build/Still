{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the vault commands and listen for events (auto-lock), and nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-touch",
    "allow-lens-new-key",
    "allow-item-encrypt",
    "allow-item-decrypt",
    "allow-item-copy",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
