{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the vault commands, listen for events (auto-lock), and be dragged and zoomed by its title strip (the overlay title bar), and nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-touch",
    "allow-item-copy",
    "allow-item-copy-field",
    "allow-startup-open",
    "allow-startup-use-old-copy",
    "allow-startup-open-old-format",
    "allow-startup-restore-v1",
    "allow-startup-open-replaced",
    "allow-vault-state",
    "allow-vault-set-aside",
    "allow-vault-change-password",
    "allow-lens-create",
    "allow-lens-rename",
    "allow-lens-forget",
    "allow-lens-restore",
    "allow-lens-delete",
    "allow-item-add",
    "allow-item-update",
    "allow-item-delete",
    "allow-item-restore",
    "allow-backup-save",
    "allow-restore-choose",
    "allow-restore-check",
    "allow-restore-confirm",
    "allow-kept-list",
    "allow-kept-trash",
    "allow-item-reveal",
    "allow-password-generate",
    "allow-passphrase-generate",
    "allow-password-strength",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
